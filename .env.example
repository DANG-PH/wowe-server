# ===== App =====
NODE_ENV=development
PORT=4000
API_PREFIX=api
CLIENT_URL=http://localhost:3000

# ===== MySQL =====
DB_HOST=localhost
# Cổng host (map <host>:3306 trong container). Dùng 3457 để tránh đụng MySQL khác trên VPS.
DB_PORT=3457
DB_USERNAME=wowe
DB_PASSWORD=wowe_password
DB_DATABASE=wowe
DB_ROOT_PASSWORD=root_password
# Tự động đồng bộ schema (chỉ dùng cho dev). Production dùng migration.
DB_SYNCHRONIZE=true
DB_LOGGING=false

# ===== Redis =====
REDIS_HOST=localhost
# Cổng host (map <host>:6379 trong container). Dùng 3456 để tránh đụng Redis khác trên VPS.
REDIS_PORT=3456
REDIS_PASSWORD=
# TTL cache mặc định (giây)
CACHE_TTL=60

# ===== JWT =====
JWT_ACCESS_SECRET=change_me_access_secret
JWT_REFRESH_SECRET=change_me_refresh_secret
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=7d

# ===== Seed / Upload =====
# URL gốc để client tải ảnh sản phẩm (ảnh tĩnh phục vụ tại /uploads)
UPLOADS_DIR=uploads
PUBLIC_URL=http://localhost:4000
